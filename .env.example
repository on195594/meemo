# Meemo Environment Configuration Example
# Copy to .env or export in your environment before running docker compose.

# REQUIRED in production: Generate with `openssl rand -hex 32`
SESSION_SECRET=

# Public application URL for RSS feeds and absolute link generation
APP_ORIGIN=http://localhost:3000

# Host port mapping for Docker Compose (default: 3000)
MEEMO_PORT=3000

# Registration policy: open, first-user (default in prod), or disabled
REGISTRATION_MODE=first-user

# Optional read-only Gemini/MCP. Node does not automatically load .env.
# Compose does NOT forward these keys; pass them explicitly only after authorization.
# See docs/GEMINI_ASSISTANT.md. Keep disabled until exact callbacks are reviewed.
MCP_ENABLED=false
MCP_PUBLIC_URL=
MCP_REDIRECT_URIS=
MCP_ALLOWED_ORIGINS=
# Optional setup only: ISO UTC deadline within 30 minutes, with MCP_ENABLED=false.
# Discovery/callback capture only; registration, tokens and note access remain denied.
MCP_BOOTSTRAP_UNTIL=
