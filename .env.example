# Meemo Environment Configuration Example
# Copy to .env or export in your environment before running docker compose.

# REQUIRED in production: Generate with `openssl rand -hex 32`
SESSION_SECRET=

# Public application URL for RSS feeds, wikilinks, and HTTPS session cookie Secure flag in production
APP_ORIGIN=http://localhost:3000

# Host port mapping for Docker Compose (default: 3000)
MEEMO_PORT=3000

# Registration policy: open (default in dev), first-user (default in prod), or disabled
REGISTRATION_MODE=first-user

# Optional non-secret runtime defaults (uncomment to override)
# TRUST_PROXY=loopback, uniquelocal
# CORS_ORIGIN=
# URL_ENRICHMENT_ENABLED=false
# MAX_ATTACHMENT_SIZE=10485760
# MAX_IMPORT_SIZE=52428800
# SHUTDOWN_TIMEOUT_MS=15000
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=1
# MONGO_TIMEOUT_MS=3000
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# LOGIN_RATE_LIMIT_MAX=10

# Optional Gemini/MCP with scoped read/write tools. Node does not automatically load .env.
# Compose does NOT forward these keys; pass them explicitly only after authorization.
# See docs/GEMINI_ASSISTANT.md. Keep disabled until exact callbacks are reviewed.
MCP_ENABLED=false
MCP_PUBLIC_URL=
MCP_REDIRECT_URIS=
MCP_ALLOWED_ORIGINS=
# Optional setup only: ISO UTC deadline within 30 minutes, with MCP_ENABLED=false.
# Discovery/callback capture only; registration, tokens and note access remain denied.
MCP_BOOTSTRAP_UNTIL=
# MCP_PROTOCOL_DEADLINE_MS=15000
