# Meemo Environment Configuration Example
# Copy to .env or export in your environment before running docker compose.

# REQUIRED in production: Generate with `openssl rand -hex 32`
SESSION_SECRET=

# Public application URL for RSS feeds and absolute link generation
APP_ORIGIN=http://localhost:3000

# Host port mapping for Docker Compose (default: 3000)
MEEMO_PORT=3000

# Registration policy: open, first-user (default in prod), or disabled
REGISTRATION_MODE=first-user
