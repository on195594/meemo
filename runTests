#!/bin/bash

set -eu

CONTAINER_NAME="mongo-server-meemo-test"
USERS_FILE="/tmp/meemo-users-test-$$.json"

cleanup() {
    rm -f "${USERS_FILE}"
    docker rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true

echo "Starting ${CONTAINER_NAME}..."
docker run --name "${CONTAINER_NAME}" -d mongo:5.0.20

export MONGODB_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${CONTAINER_NAME}")
echo "Waiting for MongoDB server to be ready..."
while ! docker exec "${CONTAINER_NAME}" mongo --quiet --eval 'db.adminCommand("ping")' >/dev/null 2>&1; do
    sleep 1
done

export CLOUDRON_MONGODB_URL="mongodb://${MONGODB_IP}:27017/meemo"
export CLOUDRON_LOCAL_AUTH_FILE="${USERS_FILE}"

./node_modules/.bin/mocha --exit src/test/*-test.js
