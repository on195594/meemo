#!/bin/bash

set -eu

TEST_RUN_ID="${MEEMO_TEST_RUN_ID:-$$}"
CONTAINER_NAME="mongo-server-meemo-test-${TEST_RUN_ID}-$$"
USERS_FILE_PATH="/tmp/meemo-users-test-${TEST_RUN_ID}-$$.json"

cleanup() {
    rm -f "${USERS_FILE_PATH}"
    docker rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker rm --force "${CONTAINER_NAME}" >/dev/null 2>&1 || true

echo "Starting ${CONTAINER_NAME}..."
docker run --name "${CONTAINER_NAME}" -d mongo:8

echo "Waiting for MongoDB server to be ready..."
while ! docker exec "${CONTAINER_NAME}" mongosh --quiet --eval 'db.adminCommand("ping")' >/dev/null 2>&1; do
    sleep 1
done

export MONGODB_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${CONTAINER_NAME}")
while [ -z "${MONGODB_IP:-}" ]; do
    sleep 1
    MONGODB_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${CONTAINER_NAME}")
done

export MONGODB_URL="mongodb://${MONGODB_IP}:27017/meemo"
export USERS_FILE="${USERS_FILE_PATH}"

./node_modules/.bin/mocha --exit --timeout 10000 src/test/*-test.js
